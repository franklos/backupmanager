[backupmanager-provider]
user = bmprovider
group = bmprovider
listen = /run/php/backupmanager-provider.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 4
pm.process_idle_timeout = 10s
php_admin_value[session.save_path] = /var/lib/backupmanager-provider-api
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[expose_php] = off
