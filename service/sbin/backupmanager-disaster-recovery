#!/usr/bin/python3 -I
import sys
sys.path.insert(0, '/usr/local/lib/backupmanager')
from backupmanager.config import load
from backupmanager.engine import Engine
from backupmanager.storage import GENERATION
from pathlib import Path
name = Path(sys.argv[0]).name
args = sys.argv[1:]
verify = bool(args and args[0] in ('verify', 'dry-run'))
if args and args[0] in ('verify', 'restore', 'dry-run'):
    args.pop(0)
if len(args) != 1 or not GENERATION.fullmatch(args[0]):
    raise SystemExit('Supply a recovery point ID. Legacy mirror backups are preserved; see docs/operations.md.')
kind = {'backupmanager-restore-data': 'data', 'backupmanager-restore-database': 'database', 'backupmanager-restore-complete': 'complete', 'backupmanager-disaster-recovery': 'disaster'}[name]
Engine(load()).restore(args[0], kind, verify)
