{
  "client_id": "",
  "credential_mode": "managed",
  "data_path": "/var/www/nextcloud/data",
  "days": "Mon,Tue,Wed,Thu,Fri,Sat,Sun",
  "destination": "ssh",
  "known_hosts": "/var/lib/backupmanager/.ssh/known_hosts",
  "nc_path": "/var/www/nextcloud",
  "nc_user": "www-data",
  "retention_days": 30,
  "runtime": "/var/lib/backupmanager",
  "s3_bucket": "",
  "s3_credentials": "/etc/backupmanager/s3-credentials.json",
  "s3_endpoint": "https://s3.amazonaws.com",
  "s3_prefix": "",
  "s3_region": "us-east-1",
  "s3_sse": "",
  "source_id": "",
  "ssh_host": "",
  "ssh_key": "/var/lib/backupmanager/.ssh/id_ed25519",
  "ssh_path": "/",
  "ssh_port": 22,
  "ssh_read_key": "/var/lib/backupmanager/.ssh/id_ed25519_restore",
  "ssh_user": "backupstore",
  "stale_hours": 48,
  "time": "02:00",
  "timezone": "UTC"
}
