NC_PATH=/var/www/nextcloud
NC_USER=www-data
DATA_PATH=/var/www/nextcloud/data
BACKUP_HOST=backup.example.com
BACKUP_USER=backup
BACKUP_PORT=22
BACKUP_PATH=/backup/clients/example
SOURCE_ID=example.nextcloud.local
SSH_KEY=/var/lib/backupmanager/.ssh/id_ed25519
DATA_SCHEDULE=Mon,Tue,Wed,Thu,Fri,Sat,Sun
DATABASE_SCHEDULE=Mon,Tue,Wed,Thu,Fri,Sat,Sun
DATA_RETENTION_DAYS=30
DATABASE_RETENTION_DAYS=30
STATUS_PATH=/var/lib/backupmanager/status
LOG_PATH=/var/log/backupmanager
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=
DB_DUMP_DIR=/var/lib/backupmanager/database
TIMEZONE=Europe/Amsterdam
